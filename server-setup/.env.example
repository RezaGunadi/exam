# Salin menjadi .env lalu sesuaikan. Berkas .env TIDAK ikut ke git.
#   cp .env.example .env
#
# `make server` akan menyalinnya otomatis bila .env belum ada.

# ── MySQL ──────────────────────────────────────────────────────────────────
# Pengguna aplikasi. Diberi seluruh hak agar bisa membuat/mengubah database
# tiap proyek. MySQL sengaja HANYA mendengar di 127.0.0.1 — tidak pernah
# terbuka ke internet.
DB_USER=reza_system
DB_PASSWORD=@Reza1234

# Password root MySQL. Dibiarkan kosong = dibuatkan acak lalu ditulis ke
# .mysql-root-password (mode 600) supaya tidak ada nilai tertebak.
MYSQL_ROOT_PASSWORD=

# Database per proyek — satu instans MySQL, data tiap proyek terpisah.
#
# Termasuk database milik aplikasi yang server block-nya TIDAK dikelola dari
# sini (exam-v1/, repost-app/, junior-app/). Databasenya tetap dibuat di sini
# supaya `sudo make mysql` cukup satu kali untuk seluruh server, dan skrip
# deploy masing-masing aplikasi tinggal memakainya.
DATABASES=stn,web_stn,exam_kelas_privat_v2,company_kelasprivat,ragh,ragh_management,amh_riset,amh,kidlearn,cuandariponsel

# ── PHP ────────────────────────────────────────────────────────────────────
# Versi PHP yang dipakai SELURUH situs dan phpMyAdmin.
#
# Ubah nilainya lalu jalankan `sudo make php`. Target itu memasang paketnya
# (menambahkan repo ondrej/sury bila distro belum menyediakan versi tersebut),
# menjadikannya `php` di terminal, MENGARAHKAN SEMUA SERVER BLOCK NGINX ke
# socket FPM-nya, lalu mematikan versi lama.
#
# Tanpa variabel ini yang terpasang adalah bawaan distro — dan bawaan distro
# tidak selalu cukup: Ubuntu 22.04 membawa 8.1, sementara Laravel 11 butuh
# minimal 8.2. Kegagalannya baru muncul saat `composer install`, jauh setelah
# setup dinyatakan berhasil.
#
#   Ubuntu 22.04 → 8.1    Ubuntu 24.04 → 8.3
#   Debian 11    → 7.4    Debian 12    → 8.2
PHP_VERSION=8.2

# ── Situs nginx ────────────────────────────────────────────────────────────
# Direktori root tiap situs dibuat di /var/www/<nama>.
#
# TIDAK SEMUA situs di server ini terdaftar di sini. Aplikasi Laravel punya
# direktori deploy sendiri (exam-v1/, repost-app/) karena server block-nya
# butuh `root .../public` dan langkah composer/migrasi/penjadwal yang tidak ada
# di sini. Mendaftarkannya di SITES justru MERUSAK: `sudo make nginx` menimpa
# server block-nya dengan versi yang root-nya salah. Skrip di direktori itu
# memeriksanya dan menolak jalan bila terlanjur terdaftar.
SITES=STN,web_stn,exam_v2,company-kelasprivat,ragh,ragh_management,amh_riset,amh,junior_app

# Situs yang dilayani container, bukan berkas di /var/www. Untuk situs ini nginx
# hanya meneruskan ke 127.0.0.1 dan direktori /var/www/<nama> tidak dibuat sama
# sekali — kecuali bila punya entri SITE_REPOS, karena di sanalah
# docker-compose.yml berada.
PROXY_SITES=exam_v2,junior_app

# Port lokal yang didengarkan tiap situs container. Format "nama=port".
#
# Tanpa entri di sini, situs container memakai bentuk lama milik Exam v2: /api/
# diteruskan ke 8080 (API Go) dan sisanya ke 3000 (Next.js). Bentuk itu SALAH
# untuk aplikasi yang mendengar di satu port saja — backend Kelas Junior
# (FastAPI) menyajikan API, /docs, /admin, dan /media dari satu proses di 8000.
#
# Kegagalannya kalau dibiarkan menebak tidak terlihat di halaman depan:
# situsnya terbuka normal, dan yang menjawab 502 hanya alamat di bawah /api/.
PROXY_PORTS=junior_app=8000

# Domain tiap situs — "nama=domain" dipisah koma. Nama harus sama persis
# dengan yang ada di SITES.
#
# INI SUMBER KEBENARAN server_name. Situs yang terdaftar di sini server
# block-nya DITULIS ULANG tiap `make nginx` (berkas lama dicadangkan sebagai
# .orig); yang tidak terdaftar tidak pernah disentuh, karena skrip tidak punya
# cara tahu nilai yang benar dan menebak akan mematikan situs yang sudah jalan.
#
# Satu situs boleh punya BEBERAPA nama, dipisah "|". Semuanya masuk ke satu
# server_name dan satu sertifikat.
#
# Varian www WAJIB ditulis kalau dipakai. Tanpa itu, www.domain-anda.com tidak
# cocok dengan blok mana pun, dan nginx menyajikannya dari situs PERTAMA menurut
# abjad — lengkap dengan sertifikat milik situs lain.
#
# Domain aplikasi yang deploy-nya di direktori sendiri (exam-v1/, repost-app/)
# TIDAK ditulis di sini — server block dan sertifikatnya diurus dari sana.
#
# Contoh:
# SITE_DOMAINS=exam_v2=exam.kelasprivat.id,amh=amhriset.com|www.amhriset.com
SITE_DOMAINS=junior_app=junior-app.ragh.co.id

# ── phpMyAdmin ─────────────────────────────────────────────────────────────
# Dilindungi basic-auth. Tanpa ini panel database terbuka bagi siapa pun yang
# menebak alamatnya.
PMA_ENABLE=true
PMA_PORT=8081
PMA_AUTH_USER=reza
PMA_AUTH_PASSWORD=@Reza1234

# Ukuran innodb_buffer_pool_size dalam MB. Kosong = dihitung ~1/4 RAM.
# Buffer pool yang lebih besar dari ukuran database TIDAK menambah kecepatan —
# isi ini setelah mengukur data, bukan menebak:
#   SELECT ROUND(SUM(data_length+index_length)/1024/1024) AS mb
#   FROM information_schema.tables WHERE table_schema NOT IN
#   ('information_schema','mysql','performance_schema','sys');
MYSQL_BUFFER_POOL_MB=

# Subdirektori yang disajikan nginx, bila berbeda dari akar repo.
# Format "nama=subdir", dipisah koma. Biasanya TIDAK perlu diisi.
#
# Dideteksi otomatis lebih dulu, berurutan:
#   public/index.php  -> Laravel, Symfony, dan hampir semua kerangka PHP
#   out/index.html    -> Next.js `output: "export"`
#   dist/index.html   -> hasil build Vite/Rollup
#
# Kalau salah, akibatnya dua-duanya buruk sekaligus: Laravel tanpa index.php di
# akar repo menjawab 403 (yang di log terbaca seperti masalah izin, padahal soal
# alamat), sementara app/, storage/, dan seluruh kode sumbernya justru bisa
# diunduh siapa saja.
#
# Contoh:
# SITE_ROOTS=STN=public,ragh=out
SITE_ROOTS=ragh=out

# ── Node.js ────────────────────────────────────────────────────────────────
# Situs yang hasil buildnya TIDAK ikut ke git, jadi harus dibangun di server.
# `sudo make node` (ikut dalam `make server`) menjalankan `npm ci && npm run
# build` di /var/www/<nama> untuk tiap nama di sini.
#
# DAFTARNYA EKSPLISIT, bukan ditebak dari ada-tidaknya package.json. Hampir
# semua proyek PHP di sini punya package.json untuk perkakas pengembangan, dan
# `npm run build` di sana bukan cuma mubazir — ia bisa menimpa aset yang sudah
# benar dengan hasil build setengah jadi.
#
# Yang TIDAK perlu masuk sini: situs yang hasil buildnya di-commit. Contohnya
# company-kelasprivat — public/build/ ada di dalam reponya, jadi tidak butuh
# Node di server sama sekali.
#
# Kosong = Node tidak dipasang dan repo NodeSource tidak pernah ditambahkan.
NODE_SITES=ragh

# Versi mayor Node.js. Paket `npm` bawaan Ubuntu 22.04 menarik Node 12.22 — di
# bawah syarat minimum hampir semua kerangka yang masih dirawat (Next.js 16
# butuh 20.9+), dan kegagalannya berupa galat sintaks di dalam node_modules yang
# terbaca seperti paketnya yang rusak.
NODE_VERSION=22

# ── Repositori tiap situs (opsional) ───────────────────────────────────────
# Situs yang punya entri di sini akan DIKLON dari git; sisanya cukup dibuatkan
# direktori kosong. Format "nama=url", dipisah koma.
#
# Nama harus sama persis dengan yang ada di SITES.
#
# Repo PRIVAT butuh kunci SSH MILIK ROOT — klonnya dijalankan di dalam
# `sudo make server`, dan sudo menyetel HOME=/root. Kunci di /home/anda/.ssh/
# tidak akan pernah dibaca, dan kegagalannya tidak menyebut alasan itu sama
# sekali. Perhatikan /root/... di bawah, bukan ~/...
#
# Semua repo di satu akun? Cukup SATU kunci, didaftarkan ke AKUN:
#   sudo ssh-keygen -t ed25519 -f /root/.ssh/id_ed25519 -N "" -C "server"
#   sudo cat /root/.ssh/id_ed25519.pub   # → github.com/settings/keys
#   sudo ssh -T git@github.com           # harus menyapa nama akun Anda
#
# Deploy key TIDAK bisa dipakai begitu: GitHub menolak kunci yang sama
# didaftarkan di repo kedua ("Key is already in use"). Kalau tetap ingin
# per-repo (hanya baca, cakupannya lebih sempit), butuh kunci berbeda tiap repo
# plus alias host — dan `IdentitiesOnly yes` wajib, kalau tidak ssh menawarkan
# kunci pertama lebih dulu dan repo kedua menjawab "Repository not found":
#   sudo tee -a /root/.ssh/config <<'EOF'
#   Host github-stn
#     HostName github.com
#     User git
#     IdentityFile /root/.ssh/deploy_stn
#     IdentitiesOnly yes
#   EOF
# lalu tulis URL-nya memakai alias itu: git@github-stn:RezaGunadi/stn.git
#
# Selalu URL SSH (git@...), bukan https:// — https meminta password.
#
# Situs container (PROXY_SITES) TETAP perlu didaftarkan di sini. nginx memang
# tidak pernah membaca /var/www/<nama>-nya, tetapi DI SANALAH docker-compose.yml
# berada — tanpa entri ini, pindah server berarti menyalin aplikasinya dengan
# tangan lagi. Yang dilewati hanyalah pembuatan direktori kosong bagi situs
# container yang tidak punya repo.
#
# Contoh:
# SITE_REPOS=STN=git@github.com:RezaGunadi/stn.git,ragh=git@github.com:RezaGunadi/ragh.git
SITE_REPOS=junior_app=git@github.com:RezaGunadi/kelas_junior.git

# ── HTTPS ──────────────────────────────────────────────────────────────────
# Cara mendapatkan sertifikat: cloudflare (bawaan) atau letsencrypt.
#
#   cloudflare  — Origin Certificate, berlaku 15 tahun, TIDAK pernah perlu
#                 diperpanjang. Butuh kredensial API di CF_ORIGIN_CA_KEY, dan
#                 HANYA sah selama situsnya diproksikan Cloudflare (awan
#                 oranye). Awan diubah jadi abu-abu = browser menolaknya.
#
#   letsencrypt — certbot, berlaku 90 hari, diperpanjang otomatis. Tidak butuh
#                 kredensial apa pun, hanya domain yang sudah mengarah ke
#                 server ini dan port 80 terbuka. Sertifikatnya dipercaya semua
#                 browser, jadi ia tetap sah dengan atau tanpa Cloudflare.
#
# Pilih letsencrypt bila Anda ingin sesedikit mungkin bergantung pada
# Cloudflare, atau bila urusan kredensial API terasa berbelit.
# SSL_METHOD=cloudflare

# Alamat email untuk pendaftaran Let's Encrypt (hanya dipakai bila
# SSL_METHOD=letsencrypt). Dikosongkan tetap jalan, tetapi Anda TIDAK akan
# diperingatkan bila perpanjangan otomatis berhenti bekerja — dan diamnya baru
# ketahuan saat sertifikat sudah mati.
# CERTBOT_EMAIL=
SSL_METHOD=letsencrypt
CERTBOT_EMAIL=rezagunadi97@gmail.com


# Origin CA Key Cloudflare. Diisi = `make ssl` menerbitkan sendiri Origin
# Certificate tiap domain di SITE_DOMAINS, tanpa membuka dashboard sama sekali.
#
# Ambil di: dash.cloudflare.com → My Profile → API Tokens → Origin CA Key.
# Nilainya diawali "v1.0-". INI BUKAN API Token biasa, dan bukan Global API Key.
#
# Kuncinya berlaku untuk SELURUH akun Cloudflare Anda — .env sudah mode 600 dan
# tidak ikut ke git, biarkan begitu.
#
# Dikosongkan? `make ssl` mencari berkas yang Anda salin sendiri ke
# certs/<domain>.pem dan certs/<domain>.key. Direktori certs/ juga diabaikan git.
CF_ORIGIN_CA_KEY=
